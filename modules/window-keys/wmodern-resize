#!/bin/sh
# wmodern-resize grow|shrink small|large -- resize the focused window around its centre: every side moves by the
# same amount (small = 10 px, large = 50 px per side, or set WMODERN_RESIZE_SMALL / WMODERN_RESIZE_LARGE).
action=${1:-}; size=${2:-small}
case $size in small) d=${WMODERN_RESIZE_SMALL:-10} ;; large) d=${WMODERN_RESIZE_LARGE:-50} ;; *) action= ;; esac
case $action in grow) ;; shrink) d=$((-d)) ;; *) echo "usage: wmodern-resize grow|shrink small|large" >&2; exit 2 ;; esac

win=$(xprop -root _NET_ACTIVE_WINDOW | grep -o "0x[0-9a-f]*")
[ -n "$win" ] && [ "$win" != 0x0 ] || exit 0
xprop -id "$win" _NET_WM_STATE | grep -q 'FULLSCREEN' && exit 0
read -r fl fr ft fb <<EOT
$(xprop -id "$win" _NET_FRAME_EXTENTS | grep -o '[0-9]\+' | tr '\n' ' ')
EOT
fl=${fl:-0}; fr=${fr:-0}; ft=${ft:-0}; fb=${fb:-0}
read -r W H <<EOT
$(wmctrl -d | awk '/\*/{split($4,a,"x"); print a[1], a[2]}')
EOT

# Outer-frame geometry, then the new one: top-left moves by -d, size changes by 2d, never below 150x80 or above the screen.
read -r x y w h <<EOT
$(xwininfo -id "$win" | awk -v fl="$fl" -v fr="$fr" -v ft="$ft" -v fb="$fb" \
  '/Absolute upper-left X/{x=$4} /Absolute upper-left Y/{y=$4} /Width:/{w=$2} /Height:/{h=$2}
   END{print x-fl, y-ft, w+fl+fr, h+ft+fb}')
EOT
nw=$((w + 2 * d)); nh=$((h + 2 * d))
[ "$nw" -lt 150 ] && nw=150; [ "$nh" -lt 80 ] && nh=80
[ "$nw" -gt "$W" ] && nw=$W; [ "$nh" -gt "$H" ] && nh=$H
nx=$(( x - (nw - w) / 2 )); ny=$(( y - (nh - h) / 2 ))
[ "$nx" -lt 0 ] && nx=0; [ "$ny" -lt 0 ] && ny=0
[ $((nx + nw)) -gt "$W" ] && nx=$((W - nw)); [ $((ny + nh)) -gt "$H" ] && ny=$((H - nh))

wmctrl -i -r "$win" -b remove,maximized_vert,maximized_horz 2>/dev/null
# A window with Static gravity (Chromium) is placed by its client area, not its frame: without this correction every
# move walks it up by the title bar's height and the title bar ends up above the screen.
ox=0; oy=0
xprop -id "$win" WM_NORMAL_HINTS | grep -q 'window gravity: Static' && { ox=$((fl - 1)); oy=$((ft - 1)); }  # Window Maker adds its 1 px border to what it is given
wmctrl -i -r "$win" -e "0,$((nx + ox)),$((ny + oy)),$((nw - fl - fr)),$((nh - ft - fb))"
