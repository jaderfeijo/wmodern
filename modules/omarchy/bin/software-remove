#!/usr/bin/env bash
# Pick installed apt packages to remove
sel=$(dpkg-query -f '${binary:Package}\t${binary:Summary}\n' -W | sort \
  | fzf --multi --prompt='Remove package > ' \
  --header='Tab: select  Enter: remove  Esc: cancel' \
  --preview='apt-cache show {1} | head -40' --preview-window=right:55% | awk '{print $1}')
[ -z "$sel" ] && exit 0
sudo apt remove $sel
read -rp $'\nDone. Press Enter to close.'
